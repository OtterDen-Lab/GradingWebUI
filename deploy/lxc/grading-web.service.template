[Unit]
Description=GradingWebUI API
Wants=network-online.target
After=network-online.target
RequiresMountsFor=__STATE_DIR__
ConditionPathIsMountPoint=__STATE_DIR__

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_USER__
WorkingDirectory=__APP_DIR__
EnvironmentFile=__STATE_DIR__/config/web.env
Environment=GRADING_DB_PATH=__STATE_DIR__/data/grading.db
Environment=TMPDIR=__STATE_DIR__/tmp
Environment=LOG_FILE=/var/logs/grading-ui.log
Environment=ERROR_LOG_FILE=/var/logs/grading-ui-errors.log
Environment=PYTHONUNBUFFERED=1
Environment=GRADING_APP_DIR=__APP_DIR__
ExecStart=__APP_DIR__/scripts/run_lxc_service.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target

# Canvas API URLs (required; users provide their own keys in the web UI)
CANVAS_API_URL=https://your-institution.instructure.com

# Required to encrypt users' Canvas API keys at rest. Use a long, random value
# and keep it stable: changing it makes previously saved keys unreadable.
CANVAS_CREDENTIAL_ENCRYPTION_KEY=replace_with_a_long_random_secret

# Optional production Canvas target
# USE_PROD_CANVAS=true
# CANVAS_API_URL_PROD=https://your-institution.instructure.com

# Legacy shared keys are optional during migration only; the web UI uses each
# user's saved key and does not fall back to these values.
# CANVAS_API_KEY=your_legacy_dev_key
# CANVAS_API_KEY_PROD=your_legacy_prod_key

# Initial instructor bootstrap (recommended for first startup)
# User is only created when GRADING_BOOTSTRAP_ADMIN_PASSWORD is set.
GRADING_BOOTSTRAP_ADMIN_USERNAME=admin
GRADING_BOOTSTRAP_ADMIN_PASSWORD=change_this_password
GRADING_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
GRADING_BOOTSTRAP_ADMIN_FULL_NAME=Administrator

# Auth cookie policy
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax

# SQLite behavior (optional tuning)
GRADING_DB_CONNECT_TIMEOUT_SECONDS=30
GRADING_DB_BUSY_TIMEOUT_MS=30000
GRADING_DB_CREATE_MIGRATION_BACKUP=true
# GRADING_DB_MIGRATION_BACKUP_DIR=/path/to/db-backups

# Startup validation (recommended to keep true in production)
GRADING_STRICT_STARTUP_CONFIG=true

# Bifrost OpenAI-compatible proxy. Bifrost controls the model catalog; select
# exposed IDs in AI Settings. The optional default is used before a system or
# personal model has been selected in the web UI.
BIFROST_BASE_URL=http://localhost:8080/v1
# BIFROST_API_KEY=replace_with_your_bifrost_token
# BIFROST_DEFAULT_MODEL=your-default-routing-alias
